NODE_ENV=development
PORT=3000
# Set this to a long random secret before production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Uganda WhatsApp number, international format without a leading +.
VITE_WHATSAPP_NUMBER=256777627421
# TinyMCE Cloud key (public browser key; restrict allowed domains in TinyMCE).
VITE_TINYMCE_API_KEY=replace-with-your-tinymce-cloud-key
# SMTP settings for admin replies to contact-form messages. Use an app password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Golden Valley School <school@example.com>
SMTP_USER=school@example.com
SMTP_PASS=replace-with-an-email-provider-app-password
# Optional path for persistent SQLite storage.
# DATABASE_PATH=C:\srv\golden-valley\school.sqlite

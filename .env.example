# Node API/local development. Vercel sets NODE_ENV in deployments.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MongoDB Atlas server-side settings. Never use VITE_ prefixes for these.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Required explicitly; the URI database path is never selected implicitly.
MONGODB_DB=golden_valley_school
# Optional; defaults to 5 in server/mongodb.js.
MONGODB_MAX_POOL_SIZE=5

# One-time bootstrap only: set these locally when running npm run admin:mongo:create.
# Do not commit credentials or keep these configured in Vercel after bootstrap.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMTP is required only for replying to contact-form messages from Admin.
SMTP_HOST=smtp.example.com
# Optional; defaults to 587. Port 465 automatically enables secure SMTP.
SMTP_PORT=587
# Optional; set true to force TLS (port 465 is secure automatically).
SMTP_SECURE=false
SMTP_FROM=Golden Valley School <school@example.com>
SMTP_USER=replace-with-smtp-account
SMTP_PASS=replace-with-an-email-provider-app-password

# Public browser/build settings; these are not server secrets.
# Replace the TinyMCE placeholder with the site's restricted browser API key.
VITE_TINYMCE_API_KEY=replace-with-your-tinymce-cloud-key
# Optional; the website has a built-in WhatsApp number fallback.
VITE_WHATSAPP_NUMBER=256777627421

# Optional legacy SQLite/local-server settings (not used by npm run start:mongo
# or the Vercel MongoDB API).
# DATABASE_PATH=C:\srv\golden-valley\school.sqlite
# MEDIA_PATH=C:\srv\golden-valley\media
# RESULTS_PATH=C:\srv\golden-valley\admission-results
# TRUST_PROXY=1
